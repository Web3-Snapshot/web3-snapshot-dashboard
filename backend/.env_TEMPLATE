# Backend Environment Template for Production Deployment
#
# This file is a template used during production deployment via deploy-production.sh
#
# Process:
# 1. This template is uploaded to S3 as 'production/backend.env'
# 2. During deployment, it's downloaded to ~/web3-snapshot/backend/.env
# 3. The {{BACKEND_SECRET_KEY}} placeholder is replaced with a randomly generated secret
# 4. The processed file is used by the backend Docker container
#
# Security: The actual secret key is never stored in version control or S3

FLASK_ENV=production
FLASK_DEBUG=False

SECRET_KEY={{BACKEND_SECRET_KEY}}
